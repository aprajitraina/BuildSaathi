# BuildSaathi environment template
# Copy to .env and customize for local/dev deployment.

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=buildsaathi_dev
MYSQL_USER=buildsaathi
MYSQL_PASSWORD=buildsaathi123
MYSQL_PORT=3306

# Design-time EF tooling (used by ApplicationDbContextFactory)
BUILDSAATHI_DB_CONNECTION=Server=localhost;Port=3306;Database=buildsaathi_dev;User=buildsaathi;Password=buildsaathi123;

# API
API_PORT=5000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_ISSUER=BuildSaathi
JWT_AUDIENCE=BuildSaathi-Client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
DB_SERVER_VERSION=8.0.36
SWAGGER_ENABLE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:55762/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_DOCUMENTS=buildsaathi-documents
MINIO_USE_SSL=false
# AI services
AI_SERVICE_PORT=8000
AI_MOCK_MODE=true
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
AI_RETRY_DELAY_MS=500
OPENAI_API_KEY=mock
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
CHROMA_HOST=localhost
CHROMA_PORT=8001
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_COLLECTION_TENDER=tender_chunks
RAG_COLLECTION_BOQ=boq_chunks
