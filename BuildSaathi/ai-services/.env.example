# AI service runtime
AI_MOCK_MODE=true
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=replace_with_real_key_when_mock_off
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096

# Reliability
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
AI_RETRY_DELAY_MS=500

# Chroma / RAG
CHROMA_HOST=localhost
CHROMA_PORT=8001
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_COLLECTION_TENDER=tender_chunks
RAG_COLLECTION_BOQ=boq_chunks

# Optional cache
REDIS_HOST=localhost
REDIS_PORT=6379
